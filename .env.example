# Charles — every environment variable, in one place.
#
# Copy to .env.local for local work. For Vercel, paste `.env.vercel` instead:
# it is the same list, laid out for the dashboard's paste box. Changing one in the Vercel dashboard
# does NOT affect a deployment that is already running: redeploy afterwards.
#
# HANDOFF-DEPLOY.md section 3 says where each value comes from.

# ── Required. Nothing works without these. ────────────────────────
SUPABASE_URL=
# Bypasses row-level security. Belongs in Vercel and nowhere else — never in a
# browser, never in the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Every model call goes through OpenRouter. Which model does which job comes
# from the model_config table, not from here.
OPENROUTER_API_KEY=
# Meta → App Settings → Basic → App Secret. Without it the webhook refuses
# every request, because it cannot prove one came from Meta.
WHATSAPP_APP_SECRET=
# Any long random string you generate. Authenticates the internal queue, the
# PDF renderer, the health detail and the cohort report.
WORKER_SECRET=
# e.g. https://fin.vercel.app — used for the connector address, the plan
# link, and this deployment calling itself.
PUBLIC_BASE_URL=

# ── To actually send WhatsApp messages ────────────────────────────
# Without these Charles still runs, still thinks and still writes to the
# database; it just sends nothing, and logs every skipped send. That is
# deliberate, so the whole flow can be exercised before a number exists.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=charles-verify

# ── Strongly recommended ──────────────────────────────────────────
# Pepper for the one-time login codes and the connector tokens. Without it
# neither the website nor the person's-own-AI connector can issue a credential.
SESSION_SECRET=
# Vercel sends this as a bearer token on scheduled runs. The cron endpoints
# fail CLOSED without it.
CRON_SECRET=
# The Jev guardrail engine. Preferred over the model backstop: calibrated,
# ~150ms, near-zero cost. If it is absent the same checks run on the `safety`
# row in model_config — but check /api/health says guardrails_live: true.
TYPESAFE_API_KEY=
# Optional. The website's WhatsApp links open the bot's own number, asked of
# Meta via WHATSAPP_PHONE_NUMBER_ID. Only needed if you want the site to show a
# different number from the bot's (digits, country code first).
WHATSAPP_PUBLIC_NUMBER=

# ── Tracking and alert emails (docs/TRACKING.md) ─────────────────
# Everything is recorded without these; they decide who is TOLD.
# Resend (resend.com, free tier: 3,000 emails a month). Without both, alert
# emails are off and /api/health says so.
RESEND_API_KEY=
# Who gets the alerts, comma-separated.
ALERT_EMAIL_TO=
# The sender. Until you verify a domain in Resend, leave this unset: the
# default (onboarding@resend.dev) only delivers to the Resend account's own
# address, so sign up to Resend with the address alerts should go to.
ALERT_EMAIL_FROM=
# UTC hour of the daily summary. 5 = 07:00 in Johannesburg.
ALERT_DIGEST_HOUR_UTC=5
# "0" keeps people's own words out of alert emails (they stay on /admin).
ALERT_EMAIL_EXCERPTS=
# Opens the dashboard at /admin. A long random string.
ADMIN_SECRET=
# Your own and your testers' numbers, comma-separated; 2780993* matches a
# prefix. Their traffic is tracked but kept out of the funnel and the daily
# numbers. Only the yes/no is stored, never the number.
INTERNAL_WA_IDS=

# ── Optional ──────────────────────────────────────────────────────
# Meta sunsets Graph versions on roughly a two-year clock, so this is config.
WHATSAPP_API_VERSION=v21.0
# Only if you point the `voice` row in model_config at Groq or OpenAI directly
# instead of OpenRouter — cheaper per hour, and the only way to get
# per-segment transcription confidence back.
GROQ_API_KEY=
OPENAI_API_KEY=
# Opens /api/knowledge-signals only (the promotion pass, docs/PROMOTION-PASS.md),
# so that job never needs WORKER_SECRET.
SIGNALS_ADMIN_SECRET=
# OPENROUTER_STREAM=0 turns off streamed model calls (diagnosis only);
# OPENROUTER_IGNORE_PROVIDERS is a comma-separated list of providers to skip.
OPENROUTER_STREAM=
OPENROUTER_IGNORE_PROVIDERS=
# Chase Intelligence (docs/INTEL-CONTRACT.md): full (the default, leave blank)
# records every turn whole; meta keeps the shape without anyone's words; off
# records nothing. Turning it down changes nothing else.
INTEL_CAPTURE=
# Local testing only.
INLINE_WORKER=
